{
  "name": "queen-md-bot",
  "description": "Queen MD WhatsApp Bot",
  "logo": "https://i.imgur.com/1dGz1.png",
  "keywords": ["whatsapp", "bot", "baileys", "queen-md"],
  "repository": "https://github.com/queen-md-bot/queen-md-bot",
  "stack": "heroku-22",
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    },
    {
      "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest"
    }
  ],
  "env": {
    "SESSION_ID": {
      "description": "Your WhatsApp Session ID - get from pairing site",
      "required": true,
      "value": ""
    },
    "PREFIX": {
      "description": "Bot Prefix",
      "required": false,
      "value": "."
    },
    "OWNER_NUMBER": {
      "description": "Owner number with country code e.g 9230xxxxxxx",
      "required": true,
      "value": ""
    },
    "OWNER_NAME": {
      "description": "Owner Name",
      "required": false,
      "value": "Queen"
    },
    "BOT_NAME": {
      "description": "Bot Name",
      "required": false,
      "value": "QUEEN-MD"
    },
    "MODE": {
      "description": "public / private / self",
      "required": false,
      "value": "public"
    }
  }
}
